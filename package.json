{
    "name":  "matn-quiz",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "pnpm@11.22.0",
    "scripts":  {
                    "dev":  "pnpm --filter @matn-quiz/web dev",
                    "dev:web":  "pnpm --filter @matn-quiz/web dev",
                    "dev:mobile":  "pnpm --filter @matn-quiz/mobile start",
                    "android":  "pnpm --filter @matn-quiz/mobile android",
                    "ios":  "pnpm --filter @matn-quiz/mobile ios",
                    "test":  "pnpm --filter @matn-quiz/web test",
                    "test:web":  "pnpm --filter @matn-quiz/web test",
                    "build":  "pnpm --filter @matn-quiz/web build",
                    "build:web":  "pnpm --filter @matn-quiz/web build",
                    "lint":  "pnpm --filter @matn-quiz/web lint",
                    "lint:web":  "pnpm --filter @matn-quiz/web lint",
                    "typecheck:web":  "pnpm --filter @matn-quiz/web typecheck",
                    "mobile:typecheck":  "pnpm --filter @matn-quiz/mobile typecheck"
                }
}
