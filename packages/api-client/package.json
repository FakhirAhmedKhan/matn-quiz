{
    "version":  "0.0.0",
    "dependencies":  {
                         "@matn-quiz/shared-types":  "workspace:*"
                     },
    "name":  "@matn-quiz/api-client",
    "private":  true,
    "type":  "module",
    "sideEffects":  false,
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "import":  "./src/index.ts",
                              "default":  "./src/index.ts"
                          },
                    "./ApiError":  {
                                       "types":  "./src/ApiError.ts",
                                       "import":  "./src/ApiError.ts",
                                       "default":  "./src/ApiError.ts"
                                   },
                    "./client":  {
                                     "types":  "./src/createApiClient.ts",
                                     "import":  "./src/createApiClient.ts",
                                     "default":  "./src/createApiClient.ts"
                                 },
                    "./retry":  {
                                    "types":  "./src/retry.ts",
                                    "import":  "./src/retry.ts",
                                    "default":  "./src/retry.ts"
                                },
                    "./types":  {
                                    "types":  "./src/types.ts",
                                    "import":  "./src/types.ts",
                                    "default":  "./src/types.ts"
                                },
                    "./url":  {
                                  "types":  "./src/url.ts",
                                  "import":  "./src/url.ts",
                                  "default":  "./src/url.ts"
                              }
                },
    "scripts":  {
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                }
}
