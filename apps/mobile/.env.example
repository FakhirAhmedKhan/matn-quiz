# ============================================================
# MATN QUIZ MOBILE API CONFIG
# ============================================================

# Physical Android/iOS device:
# Use your computer LAN IP, NOT localhost.
#
# Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.229:3001/api/v1

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.229:3001

# Change this if your backend uses another health endpoint.
EXPO_PUBLIC_API_HEALTH_PATH=/health

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Number of automatic retries for safe/transient requests.
EXPO_PUBLIC_API_RETRY_COUNT=1

# development | staging | production
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PROFILE_READ_PATH=/auth/me
EXPO_PUBLIC_PROFILE_UPDATE_PATH=/users/me
EXPO_PUBLIC_ACCOUNT_PREFERENCES_PATH=/users/me/preferences
EXPO_PUBLIC_POEM_UPDATE_PATH=/poems/:poemId
EXPO_PUBLIC_POEM_DELETE_PATH=/poems/:poemId
EXPO_PUBLIC_POEM_PROGRESS_PATH=/poems/:poemId/progress
EXPO_PUBLIC_POEM_CREATE_PATH=/poems
EXPO_PUBLIC_POEM_DETAIL_PATH=/poems/:poemId
EXPO_PUBLIC_POEM_LIST_PATH=/poems
EXPO_PUBLIC_BOOK_PROGRESS_PATH=/books/:bookId/progress
EXPO_PUBLIC_BOOK_FAVORITE_PATH=/books/:bookId/favorite
EXPO_PUBLIC_BOOK_DELETE_PATH=/books/:bookId
EXPO_PUBLIC_BOOK_CREATE_PATH=/books
EXPO_PUBLIC_BOOK_UPDATE_PATH=/books/:bookId
EXPO_PUBLIC_BOOK_LIST_PATH=/books
EXPO_PUBLIC_BOOK_DETAIL_PATH=/books/:bookId
EXPO_PUBLIC_TTS_DEFAULT_LANGUAGE=ar
EXPO_PUBLIC_TTS_VOICES_PATH=/tts/voices
EXPO_PUBLIC_TTS_DEFAULT_FORMAT=mp3
EXPO_PUBLIC_TTS_GENERATE_PATH=/tts
EXPO_PUBLIC_TTS_MAX_CHARACTERS=5000
